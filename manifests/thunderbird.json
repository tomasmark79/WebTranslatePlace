{
  "manifest_version": 2,
  "description": "Translate selected email text and drafts into your chosen language",
  "permissions": [
    "storage",
    "compose",
    "messagesModify",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js",
      "thunderbird-background.js"
    ],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webtranslateplace-thunderbird@digitalspace.name",
      "strict_min_version": "128.0"
    }
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Alt+E",
        "mac": "Command+Alt+E"
      },
      "description": "TranslatePlace: translate into language 1"
    },
    "translate-selection-secondary": {
      "description": "TranslatePlace: translate into language 2",
      "suggested_key": {
        "default": "Ctrl+Alt+W",
        "mac": "Command+Alt+W"
      }
    }
  }
}
